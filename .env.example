# Database connection URL (REQUIRED)
# Examples:
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
# MySQL: mysql://username:password@localhost:3306/database_name
# SQL Server: mssql+pyodbc://username:password@server/database?driver=ODBC+Driver+17+for+SQL+Server
# SQLite: sqlite:///path/to/database.db
DATABASE_URL=postgresql://username:password@localhost:5432/your_database

# Optional configuration
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600
DB_ECHO_SQL=false
MCP_LOG_LEVEL=INFO
QUERY_TIMEOUT=30
MAX_RESULT_ROWS=500
